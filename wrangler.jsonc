{
  "name": "badblood-site",
  "main": "join-worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/careers", "/careers/"]
  },
  // /join application storage. Create once: wrangler d1 create badblood-join-db  → paste the id below, then:
  // wrangler d1 execute badblood-join-db --remote --file join-migrations/0001_join.sql ; wrangler secret put ADMIN_KEY ; (optional) wrangler secret put IP_SALT
  "d1_databases": [ { "binding": "DB", "database_name": "badblood-join-db", "database_id": "REPLACE_AT_DEPLOY" } ],
  "triggers": { "crons": ["17 20 * * *"] }
}
